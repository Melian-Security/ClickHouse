<clickhouse>
    <logger>
        <level>warning</level>
        <log>@WORK@/log/server.log</log>
        <errorlog>@WORK@/log/server.err.log</errorlog>
    </logger>
    <tcp_port>@PORT@</tcp_port>
    <http_port>@HTTP_PORT@</http_port>
    <interserver_http_port>@IS_PORT@</interserver_http_port>
    <interserver_http_host>127.0.0.1</interserver_http_host>
    <listen_host>127.0.0.1</listen_host>
    <path>@WORK@/data/</path>
    <tmp_path>@WORK@/tmp/</tmp_path>
    <user_files_path>@WORK@/user_files/</user_files_path>
    <background_pool_size>8</background_pool_size>
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
    <macros><shard>1</shard><replica>r1</replica></macros>
    <keeper_server>
        <tcp_port>@KEEPER_PORT@</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>@WORK@/coordination/log</log_storage_path>
        <snapshot_storage_path>@WORK@/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
        </coordination_settings>
        <raft_configuration>
            <server><id>1</id><hostname>127.0.0.1</hostname><port>@RAFT_PORT@</port></server>
        </raft_configuration>
    </keeper_server>
    <zookeeper>
        <node><host>127.0.0.1</host><port>@KEEPER_PORT@</port></node>
    </zookeeper>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </trace_log>
    <users>
        <default>
            <password></password>
            <networks><ip>::1</ip><ip>127.0.0.1</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
    <profiles><default><query_profiler_cpu_time_period_ns>1000000</query_profiler_cpu_time_period_ns><query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns></default></profiles>
    <quotas><default/></quotas>
</clickhouse>
